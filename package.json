{
  "name": "tinh-hoa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tinh-hoa/web dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:db": "supabase test db",
    "secret-scan": "node scripts/protect-secrets.mjs",
    "prepare": "lefthook install",
    "supabase": "supabase",
    "sim:balance": "pnpm --filter @tinh-hoa/shared build && node scripts/sim-balance.mjs",
    "build": "pnpm --filter @tinh-hoa/shared build && pnpm --filter @tinh-hoa/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@supabase/supabase-js": "^2.119.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.5.2",
    "supabase": "^3.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  }
}
